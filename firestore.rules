rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    match /users/{userId} {
      function isOwner() {
        return request.auth != null && request.auth.uid == userId;
      }

      // A shower log entry as written by screens/shower.tsx. createdAt must be
      // close to server time so users can't backdate or future-date showers.
      function isValidLog(entry) {
        return entry is map
          && entry.keys().hasOnly(['date', 'time', 'createdAt'])
          && entry.date is string && entry.date.size() < 32
          && entry.time is string && entry.time.size() < 32
          && entry.createdAt is timestamp
          && entry.createdAt > request.time - duration.value(5, 'm')
          && entry.createdAt < request.time + duration.value(5, 'm');
      }

      // Leaderboard lists every user, so any signed-in user may read.
      allow read: if request.auth != null;

      // Signup (screens/Login.tsx) creates the user's own doc with their email.
      allow create: if isOwner()
        && request.resource.data.keys().hasOnly(['email', 'createdAt'])
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.createdAt is timestamp;

      // Logging a shower appends exactly one new, recent entry; nothing else
      // on the doc may change and existing entries can't be removed.
      allow update: if isOwner()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['timestamps'])
        && request.resource.data.timestamps is list
        && request.resource.data.timestamps.size() == resource.data.get('timestamps', []).size() + 1
        && request.resource.data.timestamps.hasAll(resource.data.get('timestamps', []))
        && isValidLog(request.resource.data.timestamps[request.resource.data.timestamps.size() - 1]);

      allow delete: if false;
    }

    // Deny everything else by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
